# Required when the web app is hosted outside the Docker host.
# Point this at LiveKit's browser-reachable, TLS-terminated WebSocket endpoint.
# Leave unset for local development at ws://localhost:7880.
LIVEKIT_PUBLIC_URL=wss://livekit.your-domain.example

# Browser API endpoint used when building jobly-web for a hosted deployment.
VITE_API_BASE_URL=https://api.your-domain.example/api

# Optional AI provider key.
GEMINI_API_KEY=
